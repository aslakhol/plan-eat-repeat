generator client {
    provider               = "prisma-client"
    output                 = "../generated/prisma"
    moduleFormat           = "esm"
    generatedFileExtension = "ts"
    importFileExtension    = "ts"
}

datasource db {
    provider = "postgres"
}

model Dinner {
    id             Int          @id @default(autoincrement())
    name           String
    tags           Tag[]
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    Plan           Plan[]
    link           String?
    notes          String?
    Household      Household    @relation(fields: [householdId], references: [id])
    householdId    String
    favourite      Boolean      @default(false)
    servings       Int?
    parts          RecipePart[]
    publicSlug     String?      @unique
    publishedAt    DateTime?
    sourceDinnerId Int?

    @@index([name])
    @@index([publishedAt])
    @@index([sourceDinnerId])
}

model RecipePart {
    id          Int                @id @default(autoincrement())
    dinner      Dinner             @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
    dinnerId    Int
    name        String?
    order       Int
    ingredients RecipeIngredient[]
    steps       RecipeStep[]

    @@index([dinnerId])
}

model RecipeIngredient {
    id     Int        @id @default(autoincrement())
    part   RecipePart @relation(fields: [partId], references: [id], onDelete: Cascade)
    partId Int
    order  Int
    name   String
    amount Float?
    unit   String?
    note   String?

    @@index([partId])
}

model RecipeStep {
    id     Int        @id @default(autoincrement())
    part   RecipePart @relation(fields: [partId], references: [id], onDelete: Cascade)
    partId Int
    order  Int
    text   String

    @@index([partId])
}

model Tag {
    value  String   @id
    Dinner Dinner[]

    @@index([value])
}

model Plan {
    id     Int      @id @default(autoincrement())
    dinner Dinner   @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
    date   DateTime

    dinnerId Int

    @@index([date])
}

model User {
    id        String  @id
    firstName String?
    lastName  String?
    imageUrl  String?

    // Not managed by clerk
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    Memberships Membership[]
}

model Household {
    id                          String            @id @default(cuid())
    name                        String
    slug                        String            @unique
    publicSlug                  String?           @unique
    importInstructions          String?
    aiImportSpendAttributionKey String            @unique @default(uuid())
    createdAt                   DateTime          @default(now())
    updatedAt                   DateTime          @updatedAt
    Dinners                     Dinner[]
    Members                     Membership[]
    Invite                      Invite[]
    AiImportAttempts            AiImportAttempt[]
}

model Membership {
    id                          Int               @id @default(autoincrement())
    household                   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
    householdId                 String
    user                        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId                      String            @unique
    aiImportSpendAttributionKey String            @unique @default(uuid())
    AiImportAttempts            AiImportAttempt[]

    role      MembershipRole
    createdAt DateTime       @default(now())
    updatedAt DateTime       @updatedAt

    @@unique([householdId, userId])
}

enum MembershipRole {
    ADMIN
    MEMBER
}

model AiImportAttempt {
    id                            String                 @id @default(cuid())
    source                        AiImportSource
    startedAt                     DateTime               @default(now())
    finishedAt                    DateTime?
    household                     Household?             @relation(fields: [householdId], references: [id], onDelete: SetNull)
    householdId                   String?
    membership                    Membership?            @relation(fields: [membershipId], references: [id], onDelete: SetNull)
    membershipId                  Int?
    householdAttributionKey       String
    membershipAttributionKey      String
    inferenceState                AiImportInferenceState @default(PENDING)
    inferenceStartedAt            DateTime?
    providerId                    String?
    requestedModelId              String?
    responseModelId               String?
    totalInputTokens              Int?
    totalOutputTokens             Int?
    estimatedAiImportCostUsd      Float?
    supadataOperationsStarted     Int                    @default(0)
    supadataCredits               Int                    @default(0)
    supadataUnknownOperationCount Int                    @default(0)

    @@index([startedAt])
    @@index([householdAttributionKey, startedAt])
    @@index([membershipAttributionKey, startedAt])
}

enum AiImportSource {
    YOUTUBE
    INSTAGRAM
    LINK
    TEXT
    PHOTO
}

enum AiImportInferenceState {
    PENDING
    NOT_INCURRED
    ESTIMATED
    UNKNOWN
}

model Invite {
    id String @id @default(cuid())

    household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
    householdId String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    expiresAt DateTime
}
