{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["SYSTEM_ADMIN_CLERK_USER_IDS", "VERCEL_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "test": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "PLAYWRIGHT_BASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "ANTHROPIC_API_KEY",
        "SUPADATA_API_KEY",
        "SKIP_ENV_VALIDATION"
      ]
    },
    "test:integration": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "PLAYWRIGHT_BASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "ANTHROPIC_API_KEY",
        "SUPADATA_API_KEY",
        "SKIP_ENV_VALIDATION"
      ]
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "PLAYWRIGHT_BASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "ANTHROPIC_API_KEY",
        "SUPADATA_API_KEY",
        "SKIP_ENV_VALIDATION"
      ]
    }
  }
}
