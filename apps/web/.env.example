
# When adding additional environment variables, the schema in "/src/env.mjs"
# should be updated accordingly.

# Prisma
DATABASE_URL=postgres://planeatrepeat:planeatrepeat@localhost:5434/planeatrepeat

# Vercel Production only. Use a direct or session-mode connection that can run
# migrations; Preview must not receive production database credentials.
MIGRATION_DATABASE_URL=

# Other
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
CLERK_SECRET_KEY=
WEBHOOK_SECRET=

# Recipe import. Put real server keys in apps/web/.env locally and in the
# deployment secret store in production, never in this tracked example.
ANTHROPIC_API_KEY=
AI_EXTRACT_MODEL=claude-opus-4-8
SUPADATA_API_KEY=
